# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/
*.nbconvert.ipynb

# --- Environment / secrets ---
.env
.env.*

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Editors ---
.vscode/
.idea/
*.swp

# --- Project data & results ---
# Raw simulation output and raw real-data pulls should be regenerated
# from configs + a seed, not committed. Keep summary figures/tables tracked.
results/raw/
data/raw/
*.h5
*.parquet
*.npz

# Keep these tracked (remove the leading "!" lines if you'd rather exclude them too)
!results/figures/
!results/tables/

# --- Logs / caches ---
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Large / generated artifacts ---
*.pkl
*.joblib

# --- Local research backups and duplicate references ---
backup_before_original_restore/
original_week2_reference/
**/results_before_execution/
research/week2_completion/original/

# Private generated Kaggle bundle input; release data is distributed separately.
compute-tools/kaggle-final-bundle-dataset/*.bin
